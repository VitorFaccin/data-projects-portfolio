{
    "schema": "pricing",
    "table": "pricing_elasticity_regression_loglog",
    "operator": "airflow_taskflow",
    "api": null,
    "bu": "pricing",
    "table_description": "Elasticity coefficients calculated from free Olist marketplace tables. The pipeline mimics a warehouse extraction with DuckDB over CSV files and estimates product-level log-log elasticity by sale location (customer state). Products without enough history fall back to category price-tier and then category averages.",
    "source": [
        "olist_orders_dataset.csv",
        "olist_order_items_dataset.csv",
        "olist_products_dataset.csv",
        "product_category_name_translation.csv",
        "olist_customers_dataset.csv"
    ],
    "column_types": {
        "product_id": {
            "column_type": "string",
            "max_length": "64",
            "description": "Unique Olist product identifier.",
            "is_metric": false,
            "is_nullable": false,
            "pii_confidentiality_impact_level": null,
            "fk_source": null
        },
        "sale_location": {
            "column_type": "string",
            "max_length": "2",
            "description": "Sale location represented by the customer state in the Olist dataset.",
            "is_metric": false,
            "is_nullable": false,
            "pii_confidentiality_impact_level": null,
            "fk_source": null
        },
        "product_category": {
            "column_type": "string",
            "max_length": "100",
            "description": "Translated Olist product category used for seasonality and fallback grouping.",
            "is_metric": false,
            "is_nullable": false,
            "pii_confidentiality_impact_level": null,
            "fk_source": null
        },
        "nivel_de_preco": {
            "column_type": "int",
            "max_length": "None",
            "description": "Price tier from 1 to 5 within sale location and category, where 1 is the lowest average price band and 5 the highest.",
            "is_metric": false,
            "is_nullable": false,
            "pii_confidentiality_impact_level": null,
            "fk_source": null
        },
        "elasticidade_preco": {
            "column_type": "float",
            "max_length": "None",
            "description": "Estimated price elasticity coefficient from the log-log regression.",
            "is_metric": true,
            "is_nullable": true,
            "pii_confidentiality_impact_level": null,
            "fk_source": null
        },
        "elasticidade_prazo": {
            "column_type": "float",
            "max_length": "None",
            "description": "Estimated delivery-time elasticity coefficient from the log-log regression.",
            "is_metric": true,
            "is_nullable": true,
            "pii_confidentiality_impact_level": null,
            "fk_source": null
        },
        "qtde_observacoes": {
            "column_type": "int",
            "max_length": "None",
            "description": "Number of daily observations used for the product-location regression.",
            "is_metric": true,
            "is_nullable": false,
            "pii_confidentiality_impact_level": null,
            "fk_source": null
        },
        "nivel_confianca": {
            "column_type": "string",
            "max_length": "10",
            "description": "Confidence level of the elasticity: alto for the product's own regression, medio for category price-tier fallback, baixo for category fallback.",
            "is_metric": false,
            "is_nullable": false,
            "pii_confidentiality_impact_level": null,
            "fk_source": null
        },
        "data_calculo": {
            "column_type": "string",
            "max_length": "10",
            "description": "Execution date of the elasticity calculation.",
            "is_metric": false,
            "is_nullable": false,
            "pii_confidentiality_impact_level": null,
            "fk_source": null
        }
    },
    "table_id": [
        "product_id",
        "sale_location"
    ],
    "partition_cols": [],
    "partition_mode": "overwrite",
    "sgbd": "local_portfolio"
}
